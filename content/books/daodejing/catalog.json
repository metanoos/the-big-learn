      "character_count": 49,
      "id": "chapter-012",
      "order": 12,
      "reading_unit_count": 1,
      "summary": "五色令人目盲；五音令人耳聋；五味令人口爽；驰骋田猎，令人心发狂；难得之货，令人行妨",
      "supplemental_unit_count": 0,
      "title": "第12章",
      "title_en": "Chapter 12",
      "title_en_source": "human"
