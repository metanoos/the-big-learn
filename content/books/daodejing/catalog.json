      "title": "第10章",
      "title_en": "Chapter 10",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-011.json",
      "character_count": 49,
      "id": "chapter-011",
      "order": 11,
      "reading_unit_count": 1,
