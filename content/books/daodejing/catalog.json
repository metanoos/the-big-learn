      "chapter_path": "books/daodejing/chapters/chapter-048.json",
      "character_count": 40,
      "id": "chapter-048",
      "order": 48,
      "reading_unit_count": 1,
      "summary": "为学日益，为道日损",
      "supplemental_unit_count": 0,
      "title": "第48章",
      "title_en": "Chapter 48",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-049.json",
      "character_count": 64,
      "id": "chapter-049",
      "order": 49,
      "reading_unit_count": 1,
      "summary": "圣人无常心，以百姓心为心",
      "supplemental_unit_count": 0,
      "title": "第49章",
      "title_en": "Chapter 49",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-050.json",
      "character_count": 79,
      "id": "chapter-050",
      "order": 50,
      "reading_unit_count": 1,
      "summary": "出生入死",
      "supplemental_unit_count": 0,
      "title": "第50章",
      "title_en": "Chapter 50",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-051.json",
      "character_count": 71,
      "id": "chapter-051",
      "order": 51,
      "reading_unit_count": 1,
      "summary": "道生之，德畜之，物形之，势成之",
      "supplemental_unit_count": 0,
      "title": "第51章",
      "title_en": "Chapter 51",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-052.json",
      "character_count": 75,
      "id": "chapter-052",
      "order": 52,
      "reading_unit_count": 1,
      "summary": "天下有始，以为天下母",
      "supplemental_unit_count": 0,
      "title": "第52章",
      "title_en": "Chapter 52",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-053.json",
      "character_count": 52,
      "id": "chapter-053",
      "order": 53,
      "reading_unit_count": 1,
      "summary": "使我介然有知，行于大道，唯施是畏",
      "supplemental_unit_count": 0,
      "title": "第53章",
      "title_en": "Chapter 53",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-054.json",
      "character_count": 90,
      "id": "chapter-054",
      "order": 54,
      "reading_unit_count": 1,
      "summary": "善建不拔，善抱者不脱，子孙以祭祀不辍",
      "supplemental_unit_count": 0,
      "title": "第54章",
      "title_en": "Chapter 54",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-055.json",
      "character_count": 81,
      "id": "chapter-055",
      "order": 55,
      "reading_unit_count": 1,
      "summary": "含德之厚，比于赤子",
      "supplemental_unit_count": 0,
      "title": "第55章",
      "title_en": "Chapter 55",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-056.json",
      "character_count": 66,
      "id": "chapter-056",
      "order": 56,
      "reading_unit_count": 1,
      "summary": "知者不言，言者不知",
      "supplemental_unit_count": 0,
      "title": "第56章",
      "title_en": "Chapter 56",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-057.json",
      "character_count": 88,
      "id": "chapter-057",
      "order": 57,
      "reading_unit_count": 1,
      "summary": "以正治国，以奇用兵，以无事取天下",
      "supplemental_unit_count": 0,
      "title": "第57章",
      "title_en": "Chapter 57",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-058.json",
      "character_count": 70,
      "id": "chapter-058",
      "order": 58,
      "reading_unit_count": 1,
      "summary": "其政闷闷，其民淳淳；其政察察，其民缺缺",
      "supplemental_unit_count": 0,
      "title": "第58章",
      "title_en": "Chapter 58",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-059.json",
      "character_count": 64,
      "id": "chapter-059",
      "order": 59,
      "reading_unit_count": 1,
      "summary": "治人事天莫若啬",
      "supplemental_unit_count": 0,
      "title": "第59章",
      "title_en": "Chapter 59",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-060.json",
      "character_count": 48,
      "id": "chapter-060",
      "order": 60,
      "reading_unit_count": 1,
      "summary": "治大国若烹小鲜",
      "supplemental_unit_count": 0,
      "title": "第60章",
      "title_en": "Chapter 60",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-061.json",
      "character_count": 82,
      "id": "chapter-061",
      "order": 61,
      "reading_unit_count": 1,
      "summary": "大国者下流，天下之交，天下之牝",
      "supplemental_unit_count": 0,
      "title": "第61章",
      "title_en": "Chapter 61",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-062.json",
      "character_count": 80,
      "id": "chapter-062",
      "order": 62,
      "reading_unit_count": 1,
      "summary": "道者万物之奥",
      "supplemental_unit_count": 0,
      "title": "第62章",
      "title_en": "Chapter 62",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-063.json",
      "character_count": 79,
      "id": "chapter-063",
      "order": 63,
      "reading_unit_count": 1,
      "summary": "为无为，事无事，味无味",
      "supplemental_unit_count": 0,
      "title": "第63章",
      "title_en": "Chapter 63",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-064.json",
      "character_count": 125,
      "id": "chapter-064",
      "order": 64,
      "reading_unit_count": 2,
      "summary": "其安易持，其未兆易谋",
      "supplemental_unit_count": 0,
      "title": "第64章",
      "title_en": "Chapter 64",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-065.json",
      "character_count": 69,
      "id": "chapter-065",
      "order": 65,
      "reading_unit_count": 1,
      "summary": "古之善为道者，非以明民，将以愚之",
      "supplemental_unit_count": 0,
      "title": "第65章",
      "title_en": "Chapter 65",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-066.json",
      "character_count": 78,
      "id": "chapter-066",
      "order": 66,
      "reading_unit_count": 1,
      "summary": "江海所以能为百谷王者，以其善下之，故能为百谷王",
      "supplemental_unit_count": 0,
      "title": "第66章",
      "title_en": "Chapter 66",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-067.json",
      "character_count": 99,
      "id": "chapter-067",
      "order": 67,
      "reading_unit_count": 2,
      "summary": "天下皆谓我道大，似不肖",
      "supplemental_unit_count": 0,
      "title": "第67章",
      "title_en": "Chapter 67",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-068.json",
      "character_count": 43,
      "id": "chapter-068",
      "order": 68,
      "reading_unit_count": 1,
      "summary": "善为士者，不武；善战者，不怒；善胜敌者，不与；善用人者，为之下",
      "supplemental_unit_count": 0,
      "title": "第68章",
      "title_en": "Chapter 68",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-069.json",
      "character_count": 54,
      "id": "chapter-069",
      "order": 69,
      "reading_unit_count": 1,
      "summary": "用兵有言：吾不敢为主，而为客；不敢进寸，而退尺",
      "supplemental_unit_count": 0,
      "title": "第69章",
      "title_en": "Chapter 69",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-070.json",
      "character_count": 47,
      "id": "chapter-070",
      "order": 70,
      "reading_unit_count": 1,
      "summary": "吾言甚易知，甚易行",
      "supplemental_unit_count": 0,
      "title": "第70章",
      "title_en": "Chapter 70",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-071.json",
      "character_count": 28,
      "id": "chapter-071",
      "order": 71,
      "reading_unit_count": 1,
      "summary": "知不知上；不知知病",
      "supplemental_unit_count": 0,
      "title": "第71章",
      "title_en": "Chapter 71",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-072.json",
      "character_count": 45,
      "id": "chapter-072",
      "order": 72,
      "reading_unit_count": 1,
      "summary": "民不畏威，则大威至",
      "supplemental_unit_count": 0,
      "title": "第72章",
      "title_en": "Chapter 72",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-073.json",
      "character_count": 64,
      "id": "chapter-073",
      "order": 73,
      "reading_unit_count": 1,
      "summary": "勇于敢则杀，勇于不敢则活",
      "supplemental_unit_count": 0,
      "title": "第73章",
      "title_en": "Chapter 73",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-074.json",
      "character_count": 55,
      "id": "chapter-074",
      "order": 74,
      "reading_unit_count": 1,
      "summary": "民不畏死，奈何以死惧之？若使民常畏死，而为奇者，吾得执而杀之，孰敢？常有司杀者杀",
      "supplemental_unit_count": 0,
      "title": "第74章",
      "title_en": "Chapter 74",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-075.json",
      "character_count": 53,
      "id": "chapter-075",
      "order": 75,
      "reading_unit_count": 1,
      "summary": "民之饥，以其上食税之多，是以饥",
      "supplemental_unit_count": 0,
      "title": "第75章",
      "title_en": "Chapter 75",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-076.json",
      "character_count": 57,
      "id": "chapter-076",
      "order": 76,
      "reading_unit_count": 1,
      "summary": "人之生也柔弱，其死也坚强",
      "supplemental_unit_count": 0,
      "title": "第76章",
      "title_en": "Chapter 76",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-077.json",
      "character_count": 79,
      "id": "chapter-077",
      "order": 77,
      "reading_unit_count": 1,
      "summary": "天之道，其犹张弓与？高者抑之，下者举之；有余者损之，不足者补之",
      "supplemental_unit_count": 0,
      "title": "第77章",
      "title_en": "Chapter 77",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-078.json",
      "character_count": 64,
      "id": "chapter-078",
      "order": 78,
      "reading_unit_count": 1,
      "summary": "天下莫柔弱于水，而攻坚强者莫之能胜，其无以易之",
      "supplemental_unit_count": 0,
      "title": "第78章",
      "title_en": "Chapter 78",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-079.json",
      "character_count": 40,
      "id": "chapter-079",
      "order": 79,
      "reading_unit_count": 1,
      "summary": "和大怨，必有余怨；安可以为善？是以圣人执左契，而不责于人",
      "supplemental_unit_count": 0,
      "title": "第79章",
      "title_en": "Chapter 79",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-080.json",
      "character_count": 75,
      "id": "chapter-080",
      "order": 80,
      "reading_unit_count": 1,
      "summary": "小国寡民",
      "supplemental_unit_count": 0,
      "title": "第80章",
      "title_en": "Chapter 80",
      "title_en_source": "human"
    },
    {
      "chapter_path": "books/daodejing/chapters/chapter-081.json",
      "character_count": 57,
      "id": "chapter-081",
      "order": 81,
      "reading_unit_count": 1,
      "summary": "信言不美，美言不信",
      "supplemental_unit_count": 0,
      "title": "第81章",
      "title_en": "Chapter 81",
      "title_en_source": "human"
    }
