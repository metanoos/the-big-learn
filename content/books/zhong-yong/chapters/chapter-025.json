      {
        "canonical_translations": [
          {
            "license": "public domain",
            "source_url": "https://en.wikisource.org/wiki/The_Chinese_Classics/Volume_1/The_Doctrine_of_the_Mean",
            "text": "The possessor of sincerity does not merely accomplish the self-completion of himself. With this quality he completes other men and things also. The completing himself shows his perfect virtue. The completing other men and things shows his knowledge. But these are virtues belonging to the nature, and this is the way by which a union is effected of the external and internal. Therefore, whenever he-the entirely sincere man-employs them,-that is, these virtues, their action will be right.",
            "translator": "Legge",
            "year": 1885
          }
        ],
