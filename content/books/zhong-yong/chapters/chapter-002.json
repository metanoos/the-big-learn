        "source_block_order": 1,
        "text": "仲尼曰：「君子中庸，小人反中庸。"
      },
      {
        "canonical_translations": [
          {
            "license": "public domain",
            "source_url": "https://en.wikisource.org/wiki/The_Chinese_Classics/Volume_1/The_Doctrine_of_the_Mean",
            "text": "The superior man's embodying the course of the Mean is because he is a superior man, and so always maintains the Mean. The mean man's acting contrary to the course of the Mean is because he is a mean man, and has no caution.\"",
            "translator": "Legge",
            "year": 1885
          }
        ],
        "character_count": 24,
        "id": "chapter-002-line-002",
        "order": 2,
        "source_block_chunk": 1,
        "source_block_order": 2,
        "text": "君子之中庸也，君子而時中；小人之中庸也，小人而無忌憚也。」"
      }
