# The Big Learn — environment template.
#
# Copy to `.env` (gitignored) and fill in real values:
#   cp .env.example .env
# The Go backend reads `.env` from the repo root on startup (config.Load).
# Every runtime variable has a sane default for local development.

# ── Server / content ────────────────────────────────────────────────────────
HTTP_ADDR=:8180
# Optional override; defaults to the repository's content/ directory.
# CONTENT_ROOT=/absolute/path/to/the-big-learn/content
# Only needed when a browser calls the Go API from a different origin. The
# normal Next.js /api rewrite is same-origin and needs no CORS header.
# CORS_ALLOWED_ORIGIN=https://reader.example.com

# ── Web app ────────────────────────────────────────────────────────────────────
# Server-side API used by Next Server Components and the /api rewrite.
API_BASE_URL=http://localhost:8180
# Public canonical origin used for metadata, sitemap, and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Optional external patronage links. Omit to render disabled placeholders.
# NEXT_PUBLIC_SUPPORT_URL=https://example.com/membership
# NEXT_PUBLIC_SUPPORT_URL_ONE_TIME=https://example.com/gift

# ── LLM (build-time tools only — NOT read by the Go backend) ───────────────
# Used by tools/sanguo_align_semantic.py and tools/generate_sanguo_poems.py.
# The backend ignores these; the tools read os.environ directly, so
# export them in the shell where you run the tools (or `set -a; source .env`).
GLM_API_KEY=
# Optional overrides (defaults shown):
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-plus
